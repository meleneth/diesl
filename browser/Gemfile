# frozen_string_literal: true
source "https://rubygems.org"
ruby "4.0.10"

# These supply ViewComponent's renderer. No Rails server/application is booted.
gem "view_component", "4.5.0"
gem "actionview", "8.1.4.1"
gem "railties", "8.1.4.1"

# Official pure-Ruby JSON implementation. The existing Ruby WASM image has a
# JSON Ruby/C API mismatch; do not load its compiled JSON extension.
gem "json_pure", "2.7.6"

# Reusable rendering and reactive state layer (pinned source, no gem release required).
gem "carbn", git: "https://github.com/meleneth/carbn.git", ref: "84c00cafe31768625378a0f8582dcdbfc2a720d0"
